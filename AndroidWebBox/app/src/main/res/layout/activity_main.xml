<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🥥 Coconut SDK"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="80dp" />

    <!-- 副标题 -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="跨平台混合应用框架"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        android:layout_marginTop="8dp" />

    <!-- Hello World 文本 -->
    <TextView
        android:id="@+id/tvHello"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        android:layout_marginTop="48dp" />

    <!-- 描述文本 -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="点击下方按钮打开 Coconut WebView，体验 H5 与 Native 的交互"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHello"
        android:layout_marginTop="24dp" />

    <!-- 打开 WebView 按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenWebView"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="打开 Coconut WebView"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_menu_view"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        android:layout_marginTop="32dp"
        app:cornerRadius="12dp" />

    <!-- 打开本地页面按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenLocal"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="打开本地测试页面"
        android:textSize="16sp"
        app:icon="@android:drawable/ic_menu_upload"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOpenWebView"
        android:layout_marginTop="16dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="12dp" />

    <!-- 打开离线包按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenOfflinePackage"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="打开离线包 (coconut://)"
        android:textSize="16sp"
        app:icon="@android:drawable/ic_menu_save"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOpenLocal"
        android:layout_marginTop="16dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="12dp" />

    <!-- Sniper YOLO API 冒烟按钮（走 coconut-network 引擎全链路） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSniperSmoke"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="Sniper API 冒烟"
        android:textSize="16sp"
        app:icon="@android:drawable/ic_menu_send"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOpenOfflinePackage"
        android:layout_marginTop="16dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="12dp" />

    <!-- 设置页（真实业务试点：离线包 hash 路由 #/settings） -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenSettings"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="设置页 (#/settings)"
        android:textSize="16sp"
        app:icon="@android:drawable/ic_menu_preferences"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSniperSmoke"
        android:layout_marginTop="16dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="12dp" />

    <!-- 热更新 manifest URL 输入框 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilManifestUrl"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="热更新 manifest URL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnOpenSettings"
        android:layout_marginTop="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etManifestUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri"
            android:text="http://10.0.2.2:8000/manifest.json"
            android:textSize="13sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 检查更新按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckUpdate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="检查热更新"
        android:textSize="14sp"
        app:icon="@android:drawable/stat_sys_download"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilManifestUrl"
        android:layout_marginTop="12dp"
        style="@style/Widget.Material3.Button.TonalButton"
        app:cornerRadius="12dp" />

    <!-- 回滚按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRollback"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="回滚到内置版本"
        android:textSize="14sp"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCheckUpdate"
        android:layout_marginTop="8dp"
        style="@style/Widget.Material3.Button.TextButton"
        app:cornerRadius="12dp" />

    <!-- 版本信息 -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Coconut SDK v1.0.0"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
