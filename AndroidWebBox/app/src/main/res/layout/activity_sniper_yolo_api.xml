<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSniper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSniperTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥥 Sniper YOLO API 冒烟（Native）"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvSniperHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="coconut-network 引擎 Kotlin 直调，不经 WebView / bridge"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="1. POST /users/test-login（拿 token）"
            android:textSize="13sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListFoods"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="2. GET /foods/?count=5（Bearer）"
            android:textSize="13sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateFood"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="3. POST /foods/（创建）"
            android:textSize="13sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGet404"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="4. GET /foods/99999（404 envelope）"
            android:textSize="13sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteFood"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="5. DELETE /foods/{id}（清理上一条）"
            android:textSize="13sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRunAll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="▶ 跑全部 5 步"
            android:textSize="15sp"
            android:textStyle="bold"
            style="@style/Widget.Material3.Button.TonalButton"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:text="清空日志"
            android:textSize="12sp"
            style="@style/Widget.Material3.Button.TextButton" />

        <TextView
            android:id="@+id/tvSniperLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minLines="6"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:background="#F7F8FA"
            android:padding="10dp"
            android:textIsSelectable="true"
            android:text="（日志区）" />

    </LinearLayout>

</ScrollView>
